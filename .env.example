# From https://dashboard.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Everything below is generated automatically by `npm run provision`:
# PRIVY_OWNER_KEY_PRIVATE / PRIVY_OWNER_KEY_PUBLIC     — backend admin key (P-256)
# PRIVY_TRADING_KEY_PRIVATE / PRIVY_TRADING_KEY_PUBLIC — backend trading key (P-256)
# PRIVY_BASE_POLICY_ID / PRIVY_TRADING_POLICY_ID / PRIVY_WITHDRAWAL_POLICY_ID
